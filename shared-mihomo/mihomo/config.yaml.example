# shared-mihomo: one host-wide mihomo, nodes from the local vpngate-hub publish
# file (zero Cloudflare traffic). Copy to config.yaml and edit paths/ports.
# The mihomo binary must understand openvpn proxy nodes (v1.19.31+).
external-controller: 127.0.0.1:7910
mode: rule
log-level: warning
allow-lan: false

proxy-providers:
  hub:
    type: file
    path: ./providers/hub-nodes.yaml
    health-check:
      enable: true
      url: http://www.gstatic.com/generate_204
      interval: 600

# One select group per listener port. Add more p79XX groups/listeners as needed;
# keep the port range in sync with register.py SHARED_MIHOMO_PORT_BASE/END (7911-7950).
proxy-groups:
  - name: p7911
    type: select
    use: [hub]
  - name: p7912
    type: select
    use: [hub]
  - name: p7913
    type: select
    use: [hub]
  - name: p7914
    type: select
    use: [hub]
  - name: p7915
    type: select
    use: [hub]
  - name: p7916
    type: select
    use: [hub]
  - name: p7917
    type: select
    use: [hub]
  - name: p7918
    type: select
    use: [hub]
  - name: p7919
    type: select
    use: [hub]
  - name: p7920
    type: select
    use: [hub]
  - name: p7921
    type: select
    use: [hub]
  - name: p7922
    type: select
    use: [hub]
  - name: p7923
    type: select
    use: [hub]
  - name: p7924
    type: select
    use: [hub]
  - name: p7925
    type: select
    use: [hub]
  - name: p7926
    type: select
    use: [hub]
  - name: p7927
    type: select
    use: [hub]
  - name: p7928
    type: select
    use: [hub]
  - name: p7929
    type: select
    use: [hub]
  - name: p7930
    type: select
    use: [hub]
  - name: p7931
    type: select
    use: [hub]
  - name: p7932
    type: select
    use: [hub]
  - name: p7933
    type: select
    use: [hub]
  - name: p7934
    type: select
    use: [hub]
  - name: p7935
    type: select
    use: [hub]
  - name: p7936
    type: select
    use: [hub]
  - name: p7937
    type: select
    use: [hub]
