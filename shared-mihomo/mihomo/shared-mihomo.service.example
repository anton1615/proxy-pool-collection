[Unit]
Description=shared-mihomo (host-wide VPNGate exit proxy pool)
After=network-online.target

[Service]
Type=simple
User=proxy
EnvironmentFile=/etc/shared-mihomo/config.env
WorkingDirectory=/opt/shared-mihomo/mihomo
# Verify the config before a restart: mihomo -t -f config.yaml -d <dir>
ExecStart=/usr/local/bin/mihomo -d /opt/shared-mihomo/mihomo -f config.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
