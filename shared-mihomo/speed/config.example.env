# Copy to config.env (gitignored) and source before the speed daemon.
# No API keys or scraped-score sources are used.

SPEED_BASE=/var/lib/vpngate-hub
SPEED_DB=/var/lib/vpngate-hub/hub.sqlite
SPEED_WORK=/var/lib/vpngate-hub/speedwork
SPEED_ALIVE=/var/lib/vpngate-hub/publish/alive-nodes.json
SPEED_X4=/var/lib/vpngate-hub/x4ranges.json

# Shared OpenVPN template (gitignored; copy ovpn-template.example.json and fill)
SHARED_MIHOMO_OVPN_TEMPLATE=/etc/shared-mihomo/ovpn-template.json
SPEED_MIHOMO=/usr/local/bin/mihomo

# Optional operator-supplied peer worker. EMPTY = build proxy blocks locally.
SPEED_PEER_URL=

SPEED_URL=https://speed.cloudflare.com/__down?bytes=8000000
SPEED_WARM_URL=https://speed.cloudflare.com/__down?bytes=200000
SPEED_IP_API=http://ip-api.com/batch?fields=query,proxy,hosting,isp
SPEED_X4_VPN=https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/vpn/ipv4.txt
SPEED_X4_DC=https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/datacenter/ipv4.txt

SPEED_BATCH=48
SPEED_MIN_AGE=3600
SPEED_IDLE_SLEEP=120
SPEED_MEASURE_SECS=6
SPEED_NODE_MAX_SECS=20
