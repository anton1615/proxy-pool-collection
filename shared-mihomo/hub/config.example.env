# Copy to config.env (gitignored) and source before the hub oneshot.
# Only the two official public VPNGate endpoints and a local inbox are used.

HUB_BASE=/var/lib/vpngate-hub
HUB_PUBLISH_DIR=/var/lib/vpngate-hub/publish
HUB_INBOX_DIR=/var/lib/vpngate-hub/inbox
HUB_DB=/var/lib/vpngate-hub/hub.sqlite
HUB_STATE=/var/lib/vpngate-hub/nodes.json

# Official public endpoints (no credentials, no third-party sources)
HUB_CSV_URL=https://www.vpngate.net/api/iphone/
HUB_CLIENT_URL=http://client.api.vpngate2.jp/api/

HUB_PROBE_TIMEOUT=3
HUB_PROBE_CONCURRENCY=64
HUB_PUBLISH_MAX=4000
