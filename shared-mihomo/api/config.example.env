# Copy to config.env (gitignored) and source before starting register.py.
# All values are placeholders; no live host or credential belongs here.

# mihomo external-controller base URL (loopback or a trusted-network address)
SHARED_MIHOMO_API=http://127.0.0.1:7910

# Where the uid -> port/node map is persisted (runtime state, gitignored)
SHARED_MIHOMO_REG_STATE=/var/lib/shared-mihomo/register.json

# Listener bind + API port
SHARED_MIHOMO_REG_BIND=127.0.0.1
SHARED_MIHOMO_REG_PORT=8095

# Allocatable port range [base, end)
SHARED_MIHOMO_PORT_BASE=7911
SHARED_MIHOMO_PORT_END=7951

# Idle-connection grace (seconds). KILL_RESP_GRACE must exceed the upstream's
# maximum inter-token gap (measured 6s); 15s is the safe floor.
KILL_RESP_GRACE=15
KILL_REQ_GRACE=30
