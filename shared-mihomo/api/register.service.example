[Unit]
Description=shared-mihomo register API (uid -> port -> node)
After=network-online.target

[Service]
Type=simple
User=proxy
EnvironmentFile=/etc/shared-mihomo/config.env
ExecStart=/usr/bin/python3 -u /opt/shared-mihomo/api/register.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
